{
  "functions": {
    "api/generate-plan.ts": {
      "maxDuration": 30,
      "includeFiles": "{src/lib/**,src/types/**,api/lib/**}"
    },
    "api/**/*.ts": {
      "includeFiles": "{src/lib/**,api/lib/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
